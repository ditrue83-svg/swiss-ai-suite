{
  "name": "swiss-ai-suite-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI-Swisse — SaaS per PMI svizzere (Admin AI + Subsidy AI) su Supabase",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:phase1": "node --env-file=.env.test scripts/test-phase1.mjs",
    "test:phase2": "node --env-file=.env.test scripts/test-phase2.mjs",
    "test:async": "node --env-file=.env.test scripts/test-async.mjs",
    "test:functions": "node --env-file=.env.test scripts/test-functions.mjs",
    "eval:admin": "node --env-file=.env.test --import tsx scripts/eval-admin-ai.ts",
    "eval:subsidy": "node --env-file=.env.test --import tsx scripts/eval-subsidy.ts",
    "subsidy:seed": "node --env-file=.env.test scripts/seed-subsidy-programs.mjs",
    "subsidy:health": "node --env-file=.env.test scripts/subsidy-catalog-health.mjs",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "check:auth": "node --env-file=.env.test scripts/check-auth-config.mjs",
    "i18n:coverage": "node scripts/i18n-coverage.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "i18n:typography": "node scripts/i18n-typography.mjs",
    "test:uid": "node --import tsx scripts/test-uid.ts",
    "test:validate": "node --import tsx scripts/test-validate.ts",
    "test:pipeline": "node --env-file=.env.test --import tsx scripts/test-pipeline.ts",
    "test:inbox-unit": "node --import tsx scripts/test-inbox-unit.ts",
    "test:inbox": "node --env-file=.env.test scripts/test-inbox.mjs",
    "inbox:diagnose": "node --env-file=.env.test scripts/inbox-diagnose.mjs",
    "test:tasks-unit": "node --import tsx scripts/test-tasks-unit.ts",
    "test:tasks": "node --env-file=.env.test scripts/test-tasks.mjs",
    "test:documents-unit": "node --import tsx scripts/test-documents-unit.ts",
    "test:documents": "node --env-file=.env.test scripts/test-documents.mjs",
    "test:calendar-unit": "node --import tsx scripts/test-calendar-unit.ts",
    "test:calendar": "node --env-file=.env.test scripts/test-calendar.mjs",
    "test:workflows-unit": "node --import tsx scripts/test-workflows-unit.ts",
    "test:workflows": "node --env-file=.env.test --import tsx scripts/test-workflows.ts",
    "test:finance-unit": "node --import tsx scripts/test-finance-unit.ts",
    "test:contracts-unit": "node --import tsx scripts/test-contracts-unit.ts",
    "test:contracts": "node --env-file=.env.test --import tsx scripts/test-contracts.ts",
    "test:finance": "node --env-file=.env.test --import tsx scripts/test-finance.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "ws": "^8.21.1"
  }
}
