{
  "name": "swiss-ai-suite-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SwissAI Suite — SaaS per PMI svizzere (Admin AI + Subsidy AI) su Supabase",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:phase1": "node --env-file=.env.test scripts/test-phase1.mjs",
    "test:phase2": "node --env-file=.env.test scripts/test-phase2.mjs",
    "eval:admin": "node --env-file=.env.test --import tsx scripts/eval-admin-ai.ts",
    "eval:subsidy": "node --env-file=.env.test --import tsx scripts/eval-subsidy.ts",
    "test:pipeline": "node --env-file=.env.test --import tsx scripts/test-pipeline.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "ws": "^8.21.1"
  }
}
